    },
    {
      "path": "./projects/mfe-two/tsconfig.spec.json"
    },
    {
      "path": "./projects/auth-lib/tsconfig.lib.json"
    },
    {
      "path": "./projects/auth-lib/tsconfig.spec.json"
    }
  ]
}